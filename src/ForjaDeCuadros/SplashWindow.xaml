<Window x:Class="ForjaDeCuadros.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="360" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Icon="pack://application:,,,/Assets/forja-de-cuadros-icon.ico">
    <Border CornerRadius="24" Background="#181716" BorderBrush="#C73B2F" BorderThickness="2">
        <Border.Effect><DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.42"/></Border.Effect>
        <Grid Margin="34">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="190" Height="190" CornerRadius="32" Background="#0E0E0D" BorderBrush="#3B3832" BorderThickness="1">
                <Image Source="pack://application:,,,/Assets/forja-de-cuadros-icon.png" Margin="8" Stretch="Uniform"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                <TextBlock Text="F O R J A   D E" Foreground="#F2E9D5" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="CUADROS" Foreground="#FFFFFF" FontSize="42" FontWeight="Bold" Margin="0,-2,0,0"/>
                <Rectangle Width="92" Height="4" Fill="#C73B2F" HorizontalAlignment="Left" Margin="0,16,0,16"/>
                <TextBlock Text="Video a sprites, sin humo." Foreground="#CFC2AA" FontSize="16"/>
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Ellipse Width="8" Height="8" Fill="#C73B2F" Margin="0,0,8,0"/>
                    <TextBlock Text="PREPARANDO EL TALLER" Foreground="#8FC3BC" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Application x:Class="ForjaDeCuadros.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Color x:Key="InkColor">#181716</Color>
        <Color x:Key="PaperColor">#F2E9D5</Color>
        <Color x:Key="PaperLightColor">#FFF9EA</Color>
        <Color x:Key="VermilionColor">#C73B2F</Color>
        <Color x:Key="TealColor">#287F76</Color>
        <Color x:Key="OchreColor">#B87927</Color>
        <SolidColorBrush x:Key="Ink" Color="{StaticResource InkColor}"/>
        <SolidColorBrush x:Key="Paper" Color="{StaticResource PaperColor}"/>
        <SolidColorBrush x:Key="PaperLight" Color="{StaticResource PaperLightColor}"/>
        <SolidColorBrush x:Key="Vermilion" Color="{StaticResource VermilionColor}"/>
        <SolidColorBrush x:Key="Teal" Color="{StaticResource TealColor}"/>
        <SolidColorBrush x:Key="Ochre" Color="{StaticResource OchreColor}"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="{StaticResource Vermilion}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E5DAC2"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFDF5"/>
            <Setter Property="BorderBrush" Value="#BEB29B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFDF5"/>
            <Setter Property="BorderBrush" Value="#BEB29B"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
